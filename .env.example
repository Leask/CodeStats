# Node.js: copy to ignored .env. Worker secrets: use .dev.vars.example.
# Four primary services: GitHub, WakaTime, Codex, OpenRouter.
# Optional account IDs; empty leaves the source unconfigured. Never commit keys.
# Builder/URL IDs select isolated anonymous public profiles, never these secrets.

# GitHub account and aggregate public/private statistics.
# Classic PAT/OAuth scopes: repo, read:user, read:org.
# Collection is read-only; the classic repo permission itself also permits writes.
GITHUB_USERNAME=
# Username alone uses bounded public REST; token adds full GraphQL/private scope.
GITHUB_TOKEN=
GITHUB_VISIBILITY=all
GITHUB_REPOSITORY_AFFILIATIONS=OWNER,COLLABORATOR,ORGANIZATION_MEMBER
# Fork bytes include upstream authors. Stars count owned repositories only.
GITHUB_INCLUDE_FORKS=true
GITHUB_INCLUDE_OWN_CONTRIBUTIONS=true

# WakaTime: public statistics work without a token for the published range.
# Public-first; fallback stays in the same range and verifies the OAuth owner.
# OAuth needs email plus read_stats.languages (or read_stats), not a heartbeat key.
# Token-only is supported: leave the username empty to resolve /users/current.
WAKATIME_USERNAME=
WAKATIME_TOKEN=
DEFAULT_RANGE=all_time

# Codex: enable only with a supported signed-in local Codex CLI on PATH.
# Node reads account/usage/read; no login credentials are copied into the card.
CODEX_USAGE_ENABLED=false
# Optional bare ID only, not a URL. A public ID alone cannot expose usage.
CODEX_USERNAME=
# Optional separate >=32-character random secret for aggregate-only imports.
# Match it on the local sync command and destination; never use a login token.
CODEX_SYNC_TOKEN=

# OpenRouter: a Management key enables account-wide token/request analytics.
# An inference key is insufficient. CodeStats only performs usage reads.
OPENROUTER_API_KEY=
# Default: last 367 completed UTC days. Optional shorter YYYY-MM-DD start.
# This changes OpenRouter only, independently of DEFAULT_RANGE.
OPENROUTER_USAGE_SINCE=

# Shared last-good cache policy; values are seconds (minimum 60).
FRESH_SECONDS=21600
RETRY_SECONDS=900
# Node-only configured-profile refresh interval: 0/off disables it (default).
# Enabled interval: integer 60–2147483 seconds. Public URL profiles stay on demand.
AUTO_REFRESH_SECONDS=0

# Node only. Preserve this service-owned SQLite directory across restarts.
HOST=127.0.0.1
PORT=8791
CODESTATS_DATA_DIR=.data

# Advanced optional extra: Anthropic organization API usage, not Claude Pro/Max.
# It is not required for the four primary services.
ANTHROPIC_ADMIN_KEY=
ANTHROPIC_USAGE_SINCE=
