# Node: copy to .env. Wrangler: copy .dev.vars.example to .dev.vars.
# Never commit real credentials. Only aggregate statistics are exposed.
# Classic PAT scopes for all visibility: repo, read:user, read:org.
# The collector performs read operations; repo scope also grants write access.
GITHUB_TOKEN=replace_with_a_server_side_github_token
# Optional: public WakaTime stats work without a token for the published range.
# To read other/private ranges, use a WakaTime OAuth token, not a heartbeat API key.
WAKATIME_TOKEN=

GITHUB_USERNAME=your-github-username
GITHUB_VISIBILITY=all
WAKATIME_USERNAME=your-wakatime-username
DEFAULT_RANGE=all_time
FRESH_SECONDS=21600
RETRY_SECONDS=900

# Node only. Cache directories and SQLite files must stay out of Git.
HOST=127.0.0.1
PORT=8791
CODESTATS_DATA_DIR=.data

# Native GitHub filters, including organization/collaborator repositories.
GITHUB_REPOSITORY_AFFILIATIONS=OWNER,COLLABORATOR,ORGANIZATION_MEMBER
# Fork bytes include upstream authors; false reproduces the reference filter.
GITHUB_INCLUDE_FORKS=true
# Include owned repositories in lifetime/recent contributed-repository counts.
GITHUB_INCLUDE_OWN_CONTRIBUTIONS=true

# Optional token-usage services. Unconfigured services stay hidden.
# OpenRouter account analytics requires a Management key, not an inference key.
# A Management key has broad administrative rights; CodeStats only reads usage.
OPENROUTER_API_KEY=
# Defaults to the last 30 completed UTC days. Optional explicit UTC start date;
# OpenRouter tokens_total supports at most 367 days in one aggregate query.
OPENROUTER_USAGE_SINCE=
# Anthropic API organization usage, not a personal Claude Pro/Max subscription.
ANTHROPIC_ADMIN_KEY=
ANTHROPIC_USAGE_SINCE=
# Node reads official account/usage/read through your existing local Codex login.
CODEX_USAGE_ENABLED=false
# Worker imports only aggregate statistics. Use a separate random secret >=32 chars
# on the local sync command and the deployed Worker; never a Codex login token.
CODEX_SYNC_TOKEN=
