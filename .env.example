# For Wrangler local development, copy this file to .dev.vars.
# Never commit .dev.vars. Only aggregate public GitHub repositories are exposed.
GITHUB_TOKEN=replace_with_a_read_only_github_token
# Optional: public WakaTime stats work without a token for the published range.
# To read other/private ranges, use a WakaTime OAuth token, not a heartbeat API key.
WAKATIME_TOKEN=
