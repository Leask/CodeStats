# Node: copy to .env. Wrangler: copy .dev.vars.example to .dev.vars.
# Never commit real credentials. Only aggregate statistics are exposed.
# Classic PAT scopes for all visibility: repo, read:user, read:org.
# The collector performs read operations; repo scope also grants write access.
GITHUB_TOKEN=replace_with_a_server_side_github_token
# Optional: public WakaTime stats work without a token for the published range.
# To read other/private ranges, use a WakaTime OAuth token, not a heartbeat API key.
WAKATIME_TOKEN=

GITHUB_USERNAME=Leask
GITHUB_VISIBILITY=all
WAKATIME_USERNAME=leask
DEFAULT_RANGE=all_time
FRESH_SECONDS=21600
RETRY_SECONDS=900

# Node only. Cache directories and SQLite files must stay out of Git.
HOST=127.0.0.1
PORT=8791
CODESTATS_DATA_DIR=.data
