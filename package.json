{
    "name": "codestats",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Cached GitHub, WakaTime, Codex and OpenRouter profile cards for Node.js and Cloudflare Workers.",
    "scripts": {
        "dev": "wrangler dev --ip 127.0.0.1 --port 8791",
        "check": "tsc --noEmit",
        "test": "vitest run",
        "build": "wrangler deploy --dry-run --outdir dist",
        "deploy": "wrangler deploy",
        "deploy:ci": "node scripts/deploy-ci.mjs",
        "test:runtime": "node scripts/cache-runtime-check.mjs",
        "test:preview": "node scripts/preview-check.mjs",
        "test:worker:browser": "npm run build && node scripts/worker-browser-check.mjs",
        "test:profiles:browser": "npm run build && node scripts/multi-profile-browser-check.mjs",
        "start": "npm run build:node && node --env-file-if-exists=.dev.vars --env-file-if-exists=.env dist/node.mjs",
        "dev:worker": "wrangler dev --ip 127.0.0.1 --port 8791",
        "build:node": "node scripts/build-node.mjs",
        "sync:codex": "npm run build:node && node --env-file-if-exists=.dev.vars --env-file-if-exists=.env scripts/sync-codex.mjs"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20261025.1",
        "@playwright/test": "^1.64.1",
        "@types/node": "^26.6.5",
        "esbuild": "^0.28.2",
        "jsonc-parser": "^3.3.1",
        "miniflare": "^5.20261019.2-beta",
        "typescript": "^7.0.2",
        "vitest": "^5.0.5",
        "wrangler": "^4.152.0"
    },
    "overrides": {
        "undici": "7.30.1"
    },
    "allowScripts": {
        "esbuild@0.28.2": true,
        "workerd@1.20261019.1": true,
        "fsevents@2.3.3": true
    },
    "engines": {
        "node": ">=26.0.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Leask/CodeStats.git"
    },
    "homepage": "https://github.com/Leask/CodeStats#readme"
}
